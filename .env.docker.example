# Copy to `.env.docker` (gitignored) and fill secrets before `docker compose up`.
# Never commit real values.

# --- Build args (optional public) ---
# Shared demo gate (not the Surfy secret). Generate with: openssl rand -hex 32
# Must match DEMO_GATE_KEY below.
# VITE_DEMO_GATE_KEY=

# --- Runtime (server) — Surfy host + credentials ---
SURFY_CONNECTION_STRING=host=https://app.example.surfy.pro;client_id=;client_secret=
# Shared demo gate — same value as VITE_DEMO_GATE_KEY. Generate: openssl rand -hex 32
# DEMO_GATE_KEY=
# Optional: secret used to sign the session cookie (defaults to client_secret). Server-only.
# DEMO_SESSION_SECRET=
# Optional: proxy rate limit (on by default). Protects upstream Surfy from floods.
# DEMO_RATE_LIMIT_PER_MIN=120         # sustained req/min per client IP
# DEMO_RATE_LIMIT_BURST=120           # burst capacity per IP (default = PER_MIN)
# DEMO_RATE_LIMIT_GLOBAL_PER_MIN=600  # cap across ALL clients
# DEMO_RATE_LIMIT_DISABLED=1          # disable the limiter

# Optional host port
# DEMOS_PORT=8080
