# Copy to `.env.docker` (gitignored) and fill secrets before `docker compose up`.
# Never commit real values.

# --- Build args (public / baked into JS at image build) ---
VITE_SURFY_BASE_URL=
# VITE_DEMO_GATE_KEY=shared-demo-password

# --- Runtime (Netlify Functions inside the container) ---
SURFY_CONNECTION_STRING=host=https://app.example.surfy.pro;client_id=;client_secret=
# DEMO_GATE_KEY=shared-demo-password

# Optional host port
# DEMOS_PORT=8080
