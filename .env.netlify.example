# Netlify Environment Variables checklist
# Copy into Netlify UI — do not commit secrets.

# --- Build (optional public) ---
# Browser always uses the site origin for /api/surfy-token and /api/v1 — no base URL needed.
# Shared demo gate (NOT the Surfy secret). Generate with: openssl rand -hex 32
# Must match the server-side DEMO_GATE_KEY below. Baked into the public JS bundle.
# VITE_DEMO_GATE_KEY=

# Floors / buildings are fetched live via API (picker in the UI).

# --- Functions (secrets — never VITE_) ---
# Single connection string:
#   host=https://app.example.surfy.pro;client_id=<tenant>;client_secret=<api-user-secret>
SURFY_CONNECTION_STRING=host=https://app.example.surfy.pro;client_id=;client_secret=
# Shared demo gate — same value as VITE_DEMO_GATE_KEY. Generate with: openssl rand -hex 32
# DEMO_GATE_KEY=
# Optional: secret used to sign the session cookie (defaults to client_secret).
# Set only to survive a client_secret rotation or to invalidate all sessions. Server-only.
# DEMO_SESSION_SECRET=
# Optional: proxy rate limit (on by default). Protects upstream Surfy from floods.
# DEMO_RATE_LIMIT_PER_MIN=120         # sustained req/min per client IP
# DEMO_RATE_LIMIT_BURST=120           # burst capacity per IP (default = PER_MIN)
# DEMO_RATE_LIMIT_GLOBAL_PER_MIN=600  # cap across ALL clients
# DEMO_RATE_LIMIT_DISABLED=1          # disable the limiter
