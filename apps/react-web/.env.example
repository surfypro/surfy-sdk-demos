# Client (browser) — optional public vars only.
# Auth + API calls always use the page origin:
#   GET  /api/surfy-token
#   POST /api/v1/...
# No VITE_SURFY_BASE_URL — the browser origin is enough.

# Optional: force a room id for the "Color room" button
# VITE_SURFY_DEMO_ROOM_ID=577183

# Optional demo gate (must match server DEMO_GATE_KEY). Generate: openssl rand -hex 32
# Shared password, not the Surfy secret — it is baked into the public browser bundle.
# VITE_DEMO_GATE_KEY=

# --- Secrets live only on the server ---
# apps/demo-server/.env (local) or Netlify Functions env:
#   SURFY_CONNECTION_STRING=host=https://…;client_id=…;client_secret=…
# Vite/Netlify proxy /api/v1 → host= from that string (never sent to the browser).
