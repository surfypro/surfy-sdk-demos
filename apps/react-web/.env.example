# Public browser vars (safe to expose — baked into the JS bundle)
#
# Leave VITE_SURFY_BASE_URL empty for Netlify / same-origin proxy to Surfy.
# For local direct calls to Surfy, set the alpha URL (requires Surfy CORS).
VITE_SURFY_BASE_URL=
VITE_SURFY_TENANT=sandbox
VITE_SURFY_FLOOR_ID=42
VITE_SURFY_BUILDING_ID=1
# Optional: force a specific room for the "Color room" button
# VITE_SURFY_DEMO_ROOM_ID=577183
#
# Optional demo gate (must match server DEMO_GATE_KEY). Not the Surfy API secret.
# VITE_DEMO_GATE_KEY=change-me-demo-gate
