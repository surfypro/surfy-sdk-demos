# Server-only secrets for demo-server (local) — NEVER commit real values.

SURFY_CONNECTION_STRING=host=https://app.example.surfy.pro;client_id=sandbox;client_secret=replace-with-api-user-secret

# Optional: reject session without matching X-Surfy-Demo-Key / ?key=
# DEMO_GATE_KEY=change-me-demo-gate

# Optional: sign session cookie with this secret (defaults to client_secret). Server-only.
# DEMO_SESSION_SECRET=

# Optional: proxy rate limit (on by default) — protects upstream Surfy from floods.
# DEMO_RATE_LIMIT_PER_MIN=120         # sustained req/min per client IP
# DEMO_RATE_LIMIT_BURST=120           # burst capacity per IP (default = PER_MIN)
# DEMO_RATE_LIMIT_GLOBAL_PER_MIN=600  # cap across ALL clients
# DEMO_RATE_LIMIT_DISABLED=1          # disable the limiter

# Local TLS (self-signed alpha only)
# SURFY_TLS_INSECURE=1

PORT=8787
