# Server-only secrets for demo-server — NEVER commit real values.
#
# host= Surfy API origin (demo proxy). HTTPS default port = 443 → omit the port.
# - Local Surfy: host=https://localhost  (Surfy must listen on 443 / JUP_PORT=443)
# - Alpha:       host=https://app-alpha.surfy.pro  (443 — never :30501)

SURFY_CONNECTION_STRING=host=https://localhost;client_id=sandbox;client_secret=replace-with-api-user-secret
SURFY_TLS_INSECURE=1

# Alpha example (prod-like TLS, no port):
# SURFY_CONNECTION_STRING=host=https://app-alpha.surfy.pro;client_id=sandbox;client_secret=replace-with-api-user-secret

# Optional: reject session without matching X-Surfy-Demo-Key / ?key=
# DEMO_GATE_KEY=change-me-demo-gate

# Optional: sign session cookie with this secret (defaults to client_secret). Server-only.
# DEMO_SESSION_SECRET=

# Optional: proxy rate limit (on by default) — protects upstream Surfy from floods.
# DEMO_RATE_LIMIT_PER_MIN=120
# DEMO_RATE_LIMIT_BURST=120
# DEMO_RATE_LIMIT_GLOBAL_PER_MIN=600
# DEMO_RATE_LIMIT_DISABLED=1

PORT=8787
