# Server-only secrets for demo-server (local) — NEVER commit real values.
# Prefer a single connection string:

SURFY_CONNECTION_STRING=host=https://app.example.surfy.pro;client_id=sandbox;client_secret=replace-with-api-user-secret

# Optional: reject token requests without matching X-Surfy-Demo-Key / ?key=
# DEMO_GATE_KEY=change-me-demo-gate

# Local TLS (self-signed alpha only)
# SURFY_TLS_INSECURE=1

PORT=8787

# Legacy discrete vars still work if SURFY_CONNECTION_STRING is unset:
# SURFY_BASE_URL=https://app.example.surfy.pro
# SURFY_CLIENT_ID=sandbox
# SURFY_CLIENT_SECRET=replace-with-api-user-secret
